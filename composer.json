{
    "name": "mxent/pwax",
    "description": "Server-driven Vue 3 SPAs and Progressive Web Apps for Laravel — author components as Blade views, ship them as JSON.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "vue",
        "vue3",
        "pwa",
        "progressive-web-app",
        "spa",
        "vue-router",
        "pinia",
        "server-driven-ui"
    ],
    "homepage": "https://github.com/mxent/pwax",
    "support": {
        "issues": "https://github.com/mxent/pwax/issues",
        "source": "https://github.com/mxent/pwax",
        "docs": "https://github.com/mxent/pwax#readme",
        "security": "https://github.com/mxent/pwax/security/policy"
    },
    "authors": [
        {
            "name": "Mxent Open Source Team",
            "email": "opensource@mxent.com",
            "homepage": "https://github.com/mxent"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/filesystem": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0",
        "matthiasmullie/minify": "^1.3"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0|^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Mxent\\Pwax\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Mxent\\Pwax\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint": "pint --test",
        "lint:fix": "pint",
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html build/coverage --coverage-text",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "analyse": "Run PHPStan static analysis.",
        "lint": "Check code style with Laravel Pint (no changes written).",
        "lint:fix": "Fix code style with Laravel Pint.",
        "test": "Run the PHPUnit test suite.",
        "test:coverage": "Run the test suite and produce a coverage report.",
        "check": "Run lint, static analysis and tests."
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mxent\\Pwax\\PwaxServiceProvider"
            ],
            "aliases": {
                "Pwax": "Mxent\\Pwax\\Facades\\Pwax"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": false,
            "php-http/discovery": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
