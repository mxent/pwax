{
    "preset": "laravel",
    "exclude": [
        "build",
        "dist",
        "node_modules",
        "vendor"
    ],
    "rules": {
        "declare_strict_types": false,
        "concat_space": {
            "spacing": "one"
        },
        "not_operator_with_successor_space": true,
        "ordered_imports": {
            "sort_algorithm": "alpha"
        },
        "no_unused_imports": true,
        "php_unit_method_casing": {
            "case": "snake_case"
        }
    }
}
