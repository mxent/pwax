* text=auto eol=lf

# Keep `composer require` downloads small: exclude development-only files from
# the distributed package. `dist/` and `resources/` are NOT excluded — they are
# what the package ships.
/.github            export-ignore
/tests              export-ignore
/workbench          export-ignore
/.editorconfig      export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/.prettierrc.json   export-ignore
/build.js           export-ignore
/eslint.config.js   export-ignore
/package.json       export-ignore
/package-lock.json  export-ignore
/phpstan.neon       export-ignore
/phpunit.xml        export-ignore
/pint.json          export-ignore
/vitest.config.js   export-ignore
/CONTRIBUTING.md    export-ignore

# Never diff or merge the built bundle by hand.
/dist/pwax.js       linguist-generated=true -diff
/dist/pwax.js.map   linguist-generated=true -diff -merge
/resources/vendor/  linguist-vendored=true
